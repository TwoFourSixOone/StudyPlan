# =============================================
# 学生端小程序 - 生产/构建环境（npm run build:mp-weixin）
# 云托管地址与实例信息集中在文件内，源码不再硬编码
# =============================================

# 本地后端地址（仅 VITE_USE_LOCAL=true 时生效）
VITE_API_BASE_URL=http://localhost:80/api

# 构建产物默认走微信云托管
VITE_USE_LOCAL=false

# 微信云托管环境 ID
VITE_CLOUD_ENV=prod-d8g1ado543d76cfe4

# 云托管服务名（X-WX-SERVICE）
VITE_CLOUD_SERVICE=springboot-0kxz

# 云托管公网地址（callContainer 失败时降级，不含 /api 前缀）
VITE_CLOUD_BASE_URL=https://springboot-0kxz-337659-13-1520028634.sh.run.tcloudbase.com
