# =============================================
# 学生端小程序 - 环境变量模板
# 用法：复制为 .env.development / .env.production 后按环境填写
# 注意：只有 VITE_ 前缀的变量会被注入到客户端代码
# =============================================

# 本地后端地址（含 /api 前缀）
# 微信小程序不支持 Vite proxy，必须是完整 URL
VITE_API_BASE_URL=http://localhost:80/api

# 是否强制使用本地后端
# true  = 走 uni.request 直连 VITE_API_BASE_URL
# false = 走微信云托管（需要下方 CLOUD_* 配置）
# 不配置 = 按构建模式推断（dev 用本地，build 用云托管）
VITE_USE_LOCAL=

# 微信云托管环境 ID（wx.cloud.callContainer 的 config.env）
VITE_CLOUD_ENV=

# 云托管服务名（请求头 X-WX-SERVICE）
VITE_CLOUD_SERVICE=

# 云托管公网地址（callContainer 失败时降级使用，不含 /api 前缀）
VITE_CLOUD_BASE_URL=
