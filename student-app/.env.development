# =============================================
# 学生端小程序 - 开发环境（npm run dev:mp-weixin）
# =============================================

# 本地后端地址（含 /api 前缀）
VITE_API_BASE_URL=http://localhost:80/api

# 开发环境固定走本地后端，避免误连云托管
VITE_USE_LOCAL=true

# 云托管配置在开发环境留空
VITE_CLOUD_ENV=
VITE_CLOUD_SERVICE=
VITE_CLOUD_BASE_URL=
