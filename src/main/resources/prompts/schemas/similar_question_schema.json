{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Similar Question Output Schema",
  "description": "举一反三 Agent 输出校验 Schema（与出题 Agent 的 questionId/questionSource/taskType 结构不同）",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["knowledgePointId", "content"],
    "properties": {
      "knowledgePointId": {
        "type": "string",
        "description": "关联知识点 ID（必须与输入一致）"
      },
      "content": {
        "type": "object",
        "required": ["stem", "answer", "formatType"],
        "properties": {
          "stem": { "type": "string", "minLength": 1, "description": "题干" },
          "choices": {
            "type": "array",
            "description": "选项（formatType=choice 时必填，至少 2 个；其他题型为空数组）",
            "items": {
              "type": "object",
              "required": ["label", "text"],
              "properties": {
                "label": { "type": "string", "pattern": "^[A-H]$", "description": "选项标签，A/B/C/D" },
                "text": { "type": "string", "minLength": 1, "description": "选项内容（不含标签前缀）" }
              }
            }
          },
          "answer": {
            "type": "string",
            "minLength": 1,
            "description": "标准答案；选择题必须为选项标签（A/B/C/D）"
          },
          "analysis": { "type": "string", "description": "解析" },
          "formatType": {
            "type": "string",
            "enum": ["choice", "numeric", "short", "self"],
            "description": "题目形式"
          },
          "difficulty": {
            "type": "string",
            "enum": ["basic", "standard", "challenge"],
            "description": "难度"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "formatType": { "const": "choice" } },
              "required": ["formatType"]
            },
            "then": {
              "required": ["choices"],
              "properties": { "choices": { "minItems": 2 } }
            }
          }
        ]
      }
    }
  }
}
