{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Learning Plan Output Schema",
  "description": "规划 Agent 输出校验 Schema：把目标周期拆成每日计划骨架",
  "type": "object",
  "required": ["days", "reason"],
  "properties": {
    "days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 90,
      "items": {
        "type": "object",
        "required": ["date", "kpIds", "questionCount"],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "学习日期（YYYY-MM-DD，必须落在目标周期内）"
          },
          "kpIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": { "type": "string" },
            "description": "当日要学习的知识点 ID（只能来自给定知识点清单）"
          },
          "questionCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15,
            "description": "当日题量"
          },
          "focus": {
            "type": "string",
            "maxLength": 50,
            "description": "当日学习重点（可选，用于展示）"
          }
        }
      }
    },
    "reason": {
      "type": "string",
      "maxLength": 500,
      "description": "整体规划思路说明"
    }
  }
}
