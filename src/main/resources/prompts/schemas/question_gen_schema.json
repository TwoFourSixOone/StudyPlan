{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Question Generation Output Schema",
  "description": "出题 Agent 输出结构校验 Schema",
  "type": "array",
  "minItems": 1,
  "maxItems": 20,
  "items": {
    "type": "object",
    "required": ["questionId", "questionSource", "taskType", "knowledgePointId", "content"],
    "properties": {
      "questionId": {
        "type": "integer",
        "description": "题目 ID（题库原题使用已有 ID，生成题使用 0）"
      },
      "questionSource": {
        "type": "string",
        "enum": ["bank", "generated"],
        "description": "题目来源"
      },
      "taskType": {
        "type": "string",
        "enum": ["review", "redo", "similar", "comprehensive"],
        "description": "任务类型"
      },
      "knowledgePointId": {
        "type": "string",
        "description": "关联知识点 ID"
      },
      "content": {
        "type": "object",
        "required": ["stem", "answer", "formatType", "difficulty"],
        "properties": {
          "stem": {
            "type": "string",
            "minLength": 1,
            "description": "题干内容"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "text"],
              "properties": {
                "label": { "type": "string" },
                "text": { "type": "string" }
              }
            },
            "description": "选择题选项（仅 formatType=choice 时必填）"
          },
          "answer": {
            "type": "string",
            "minLength": 1,
            "description": "标准答案"
          },
          "analysis": {
            "type": "string",
            "description": "解析说明"
          },
          "formatType": {
            "type": "string",
            "enum": ["choice", "numeric", "short", "self"],
            "description": "题目形式"
          },
          "difficulty": {
            "type": "string",
            "enum": ["basic", "standard", "challenge"],
            "description": "难度级别"
          }
        }
      }
    }
  }
}
