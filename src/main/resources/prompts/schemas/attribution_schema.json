{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Knowledge Point Attribution Output Schema",
  "description": "归因 Agent 输出校验 Schema",
  "type": "array",
  "minItems": 1,
  "maxItems": 50,
  "items": {
    "type": "object",
    "required": ["questionIndex", "knowledgePointId", "confidence"],
    "properties": {
      "questionIndex": {
        "type": "integer",
        "minimum": 1,
        "description": "题目序号"
      },
      "knowledgePointId": {
        "type": "string",
        "description": "匹配的知识点 ID（无法匹配时为空字符串）"
      },
      "confidence": {
        "type": "string",
        "enum": ["high", "medium", "low"],
        "description": "匹配置信度"
      },
      "reason": {
        "type": "string",
        "maxLength": 200,
        "description": "匹配理由"
      }
    }
  }
}
